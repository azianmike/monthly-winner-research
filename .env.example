# Copy to .env beside run_agents.py. Never commit .env or paste your key in chat.
# Application key permissions: api.agents.read, api.agents.write,
# api.responses.write, and Files API access for input uploads.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
AGENT_OUTPUT_DIR=agent_downloads
